# ---- 基础 ----
ENV=dev
APP_TIMEZONE=Asia/Shanghai

# ---- 数据库 ----
# 默认 SQLite，开箱即用；上线切 PostgreSQL 时改成：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/studyroom
DATABASE_URL=

# ---- 认证 ----
# 生产环境必须替换成随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 跨域 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI 智能体 ----
# provider: mock(内置模板兜底) | deepseek | qwen | openai | ollama
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
AGENT_RATE_LIMIT_PER_MINUTE=6

# ---- WebSocket ----
WS_HEARTBEAT_TIMEOUT=60